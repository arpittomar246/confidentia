# CONFIDENTIA -- copy to .env and adjust. Never commit .env.
#
# Every value here maps to a field in src/confidentia/config/settings.py.
# Nested settings use their own prefix (SPARK_, POSTGRES_, TEE_, ...), not
# CONFIDENTIA_, so that a subsystem's configuration can be exported to a
# container or an Airflow task without dragging the whole settings tree along.

# ---------------------------------------------------------------- platform
CONFIDENTIA_ENV=local
# core | batch | stream | bench | demo  -- which slice of the stack is running.
CONFIDENTIA_PROFILE=core
CONFIDENTIA_LOG_LEVEL=INFO
CONFIDENTIA_LOG_JSON=false

# The lakehouse root. MUST NOT be inside OneDrive/Dropbox: Delta transaction
# logs and Spark spill files are corrupted by file-sync agents, and settings.py
# will refuse to start if it detects one.
#   WSL/Linux : /home/<user>/confidentia-data
#   Windows   : C:/confidentia-data
CONFIDENTIA_DATA_ROOT=/home/arpit/confidentia-data

# ------------------------------------------------------------------- spark
# local[2] not local[*]: oversubscribing a 4-core laptop adds more benchmark
# variance than most of the effects being measured.
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DEFAULT_PARALLELISM=4
SPARK_ADAPTIVE_ENABLED=true
SPARK_UI_ENABLED=true
SPARK_UI_PORT=4040
SPARK_TARGET_FILE_SIZE_MB=128
# Spark 3.5 supports Java 8/11/17 only. Leave blank to auto-detect JDK 17.
SPARK_JAVA_HOME=

# ----------------------------------------------------------------- storage
STORAGE_BACKEND=local
STORAGE_BUCKET=confidentia
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# ---------------------------------------------------------------- postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=confidentia
POSTGRES_PASSWORD=confidentia
POSTGRES_DATABASE=confidentia
# Source-of-record OLTP database that the CDC path replicates from.
POSTGRES_OLTP_DATABASE=ehr_oltp
POSTGRES_POOL_SIZE=5

# ------------------------------------------------------------------- kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS_RAW=fin.txn.raw
KAFKA_TOPIC_CLINICAL_RAW=clin.event.raw
KAFKA_TRANSACTIONS_PARTITIONS=6
KAFKA_CLINICAL_PARTITIONS=3
KAFKA_CONSUMER_GROUP=confidentia-silver
KAFKA_WATERMARK_MINUTES=10

# ------------------------------------------------------------------ crypto
# inmemory (tests) | file (local sealed keystore) | azure-mhsm (Managed HSM + SKR)
CRYPTO_KMS_BACKEND=file
CRYPTO_MASTER_KEY_ID=confidentia-mek-v1
CRYPTO_DATA_KEY_ROTATION_DAYS=90
CRYPTO_AES_KEY_BITS=256
# pme | envelope | none  -- set from the Stage 1 spike result. See
# docs/adr/0007-column-encryption-strategy.md.
CRYPTO_COLUMN_ENCRYPTION=envelope
CRYPTO_ATTESTATION_CURVE=P-256
CRYPTO_ATTESTATION_NONCE_TTL_SECONDS=300

# --------------------------------------------------------------------- tee
# sim | gramine-sgx | snp-cvm
# Under 'sim', enclave-transition and EPC-paging costs are MODELLED, not
# measured. Reporting code must label them accordingly.
TEE_BACKEND=sim
TEE_EPC_SIZE_MB=128
TEE_SIM_ECALL_LATENCY_US=8.0
TEE_SIM_OCALL_LATENCY_US=12.0
TEE_SIM_PAGE_FAULT_US=50.0
TEE_SIM_COLD_START_MS=120.0
# Fail closed: no attestation, no key release, no pipeline.
TEE_REQUIRE_ATTESTATION=true

# -------------------------------------------------------------- disclosure
DISCLOSURE_ENABLED=true
DISCLOSURE_MIN_CELL_COUNT=5
DISCLOSURE_DIFFERENTIAL_PRIVACY_ENABLED=false
DISCLOSURE_DP_EPSILON=1.0

# ----------------------------------------------------------- data quality
DQ_PROMOTION_THRESHOLD=0.95
DQ_MAX_QUARANTINE_RATE=0.10
DQ_FRESHNESS_SLA_MINUTES=60

# -------------------------------------------------------------------- auth
# Generate a real one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=dev-only-change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=7
