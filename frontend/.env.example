# Where the console finds the API.
#
# Unset by default, which means requests go to /api and Vite's dev proxy forwards
# them — keeping the token same-origin in development. Set it to call the API
# directly, which is what the compose frontend service does.
# VITE_API_BASE_URL=http://localhost:8000

# Where the dev proxy forwards to. Not a VITE_ variable on purpose: it is read by
# vite.config.ts only and must never be bundled into the client.
# API_ORIGIN=http://127.0.0.1:8000
